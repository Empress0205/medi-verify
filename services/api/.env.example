# Copy to .env and fill in. Never commit .env.

# Database — SQLite locally; use a Postgres URL in production
DATABASE_URL=sqlite+aiosqlite:///./mediguard.db

# JWT signing secret — use a long random string in production
SECRET_KEY=change-me

# Dashboard admin account (re-synced on every start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Verification engine: mock (no key needed) or gemini
ENGINE=mock
GEMINI_API_KEY=

# Hours between TMDA register refreshes (0 disables)
REGISTER_SYNC_HOURS=24
